# ============================================================
# ai-harvester-vault Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# ------------------------------------------------------------------
# Database (default: SQLite — zero-config, works on Android/Termux)
# ------------------------------------------------------------------
# SQLite (recommended for Android, no install needed):
DATABASE_URL=sqlite+aiosqlite:///./harvester.db

# PostgreSQL (optional, if you install via Termux):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/harvester

# Supabase / Neon (cloud free tier):
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# ------------------------------------------------------------------
# Redis (optional queue — only needed if you run background workers)
# ------------------------------------------------------------------
# Redis (optional, install via Termux: pkg install redis):
REDIS_URL=redis://localhost:6379/0

# If you don't have Redis, the API still works — background crawl
# jobs are processed inline instead of via a queue.

# ------------------------------------------------------------------
# Master Encryption Key (REQUIRED — generate once, never lose it)
# ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Store this safely — if you lose it, encrypted credentials are lost.
MASTER_ENCRYPTION_KEY=

# ------------------------------------------------------------------
# LLM Provider API Keys (at least one recommended for extraction)
# ------------------------------------------------------------------
GROQ_API_KEY=          # https://console.groq.com (free tier: 6K RPM)
GEMINI_API_KEY=        # https://aistudio.google.com (free tier)
OLLAMA_BASE_URL=http://localhost:11434  # Local LLM (run Ollama in Termux)

# ------------------------------------------------------------------
# Search APIs (for web discovery — optional)
# ------------------------------------------------------------------
SERPER_API_KEY=        # https://serper.dev (2,500 searches/month free)
TAVILY_API_KEY=        # https://tavily.com (1,000 searches/month free)

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000